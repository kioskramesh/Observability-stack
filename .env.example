# Copy to .env and fill in values you need.
# Datadog is optional — leave blank to run the OSS stack only.

# App
APP_NAME=order-service
APP_ENV=local
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# Datadog (optional — get a free trial key at https://www.datadoghq.com)
DD_API_KEY=
DD_SITE=datadoghq.com
DD_ENV=local
DD_SERVICE=order-service
DD_VERSION=1.0.0

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin